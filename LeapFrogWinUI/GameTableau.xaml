<?xml version="1.0" encoding="utf-8"?>
<Page x:Name="pgGameTableau"
      x:Class="LeapFrogWinUI.GameTableau"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:LeapFrogWinUI"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      Height="800"
      Width="1575">

    <Grid Name="gameTableau"
          Background="Blue"
          BorderThickness="2"
          BorderBrush="White"
          CornerRadius="10"
    >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1550"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="610"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>

        <!--Game Tableu Header -->
        <Grid Name="bdrHeader"
              Grid.Row="0"
              Margin="2,2"
              Width="1548"
              Height="60"
              Background="Blue"
              BorderThickness="1"
              BorderBrush="Black"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="picGameImage"
                   Source="/Assets/GameImages/SmilingFrogFace.ico"
                   Stretch="Uniform"
                   Grid.Column="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="0,0,0,0"
                   FocusVisualPrimaryBrush="#FF0000C0"
            />

            <!--Background="Blue"-->
            <Border Name="brdGameTimer"
                    Grid.Column="2"
                    BorderBrush="White"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="50"
                    Width="200"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Blue"
            >
                <TextBlock x:Name="myTimerDisplay"
                         HorizontalAlignment="Center"
                         HorizontalTextAlignment="Center"
                         VerticalAlignment="Center"
                         Height="auto"
                         Width="190"
                         FontFamily="Helvetica"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="White"
                />
            </Border>

            <Border Name="brdMoveCount"
                    Grid.Column="3"
                    BorderBrush="White"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="3,3,3,3"
                    Height="50"
                    Width="200"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Blue"
            >
                <TextBlock x:Name="tbMoveCount"
                         Text=""
                         Width="190"
                         Height="46"
                         HorizontalTextAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="Helvetica"
                         FontSize="24"
                         FontWeight="Bold"
                         FontStyle="Italic"
                         Foreground="White"
                />
            </Border>

            <Border Name="brdCurrentActivity"
                    Grid.Column="4"
                    BorderBrush="White"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="50"
                    Width="400"
                    Background="Blue"
            >
                <!--Margin="1,1,1,1"-->
                <TextBlock x:Name="tbCurrentActivity"
                         Text="Initializing..."
                         Width="390"
                         Height="46"
                         HorizontalTextAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="24"
                         FontFamily="Helvetica"
                         FontWeight="Medium"
                         FontStyle="Italic"
                         Foreground="White"
                />
            </Border>
        </Grid>

        <!--Game Tableu Playing Area -->
        <!--IsItemClickEnabled="True"
                  ItemClick="dataGridGameBoard_ItemClick"-->
        <GridView x:Name="dataGridGameBoard"
                  Grid.Row="1"
                  ItemsSource="{x:Bind gameDeck.deckCards, Mode=OneWay}"
                  Margin="2"
                  Height="595"
                  Width="1545"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="Blue"
                  BorderThickness="2"
                  BorderBrush="White"
                  IsItemClickEnabled="True"
                  SelectionMode="Single"
                  SelectionChanged="dataGridGameBoard_SelectionChanged"
        >

            <GridView.ItemTemplate>
                <DataTemplate x:Name="CardPosition"
                >
                    <!--Margin="1,1,1,1"-->
                    <StackPanel x:Name="PlayingCard"
                                Height="142"
                                Width="114"
                    >
                        <StackPanel.Resources>
                            <Storyboard x:Name="ZoomInMoveableKing">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1" To="1.5" Duration="0:0:0"
                                />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1" To="1.5" Duration="0:0:0"
                                />
                            </Storyboard>
                        </StackPanel.Resources>

                        <Border x:Name="CardBorder"
                                Height="138"
                                Width="110"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="White"
                                BorderThickness="1"
                                CornerRadius="10"
                                Background="DarkGray"
                        >
                            <Image x:Name="CardFace"
                                    Stretch="Uniform"
                                    Source="{Binding cardFace, Mode=TwoWay}"
                             />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="13"
                                   Orientation="Horizontal"
                    />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <!--Game Tableu Footer -->
        <Grid Name="grdActions"
              Grid.Row="2"
              Margin="2"
              Height="48"
              Width="1478"
              Background="Blue"
              BorderThickness="2"
              BorderBrush="Black"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="46"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnNewGame"
                    Content="New Game"
                    Grid.Column="2"
                    Margin="2,2,2,2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    FontSize="24pi"
                    Foreground="White"
                    Background="BlueViolet"
                    Click="btnNewGame_Click"
            />

            <Button x:Name="btnStats"
                    Content="Statistics"
                    Grid.Column="7"
                    Margin="2,2,2,2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    FontSize="24pi"
                    Foreground="White"
                    Background="BlueViolet"
                    Click="btnStats_Click"
            />

            <Button x:Name="btnHelp"
                    Content="Help"
                    Grid.Column="8"
                    Margin="2,2,2,2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    FontSize="24pi"
                    Foreground="White"
                    Background="BlueViolet"
                    Click="btnHelp_Click"
            />

            <Button x:Name="btnExit"
                    Content="Exit"
                    Grid.Column="9"
                    Margin="2,2,2,2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    FontSize="24pi"
                    Foreground="White"
                    Background="BlueViolet"
                    Click="btnExit_Click"
            />
        </Grid>
    </Grid>
</Page>
