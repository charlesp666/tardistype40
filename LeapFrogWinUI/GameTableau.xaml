<?xml version="1.0" encoding="utf-8"?>
<Page x:Name="pgGameTableau"
      x:Class="LeapFrogWinUI.GameTableau"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:LeapFrogWinUI"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      Height="800"
      Width="1575"
>

    <Page.Resources>
        <!--Style to Apply to the Display Player Statistics Dialog -->
        <Style x:Key="DialogButtonStyle"
               TargetType="Button"
        >
            <Setter Property="Background" Value="Blue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--Style to Apply to the Borders of the Header objects -->
        <Style x:Key="HeaderBorderStyle"
               TargetType="Border"
        >
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Blue"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="2,2,2,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--Style to Apply to the TextBlocks in the Border -->
        <Style x:Key="HeaderTextBlockStyle"
               TargetType="TextBlock"
        >
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="Helvetica"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
    </Page.Resources>

    <Grid Name="gameTableau"
          Background="Blue"
          BorderThickness="2"
          BorderBrush="White"
          CornerRadius="10"
    >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1550"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="610"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>

        <!--Game Tableu Header -->
        <Grid Name="bdrHeader"
              Grid.Row="0"
              Margin="2,2"
              Width="1548"
              Height="60"
              Background="Blue"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Border Name="brdGameIcon"
                    Grid.Column="0"
                    Style="{StaticResource HeaderBorderStyle}"
            >
                <!--Margin="0,0,0,0"
                   FocusVisualPrimaryBrush="#FF0000C0"-->
                <Image x:Name="picGameImage"
                   Source="/Assets/GameImages/SmilingFrogFace.ico"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                />
            </Border>

            <Grid x:Name="GameHeader"
                  Grid.Column="1"
                  Margin="2,2,2,2"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Border Name="brdCurrentActivity"
                        Grid.Column="0"
                        Width="400"
                        Style="{StaticResource HeaderBorderStyle}"
                >
                    <TextBlock x:Name="tbCurrentActivity"
                               Text="Initializing..."
                               Width="390"
                               Style="{StaticResource HeaderTextBlockStyle}"
                    />
                </Border>
      
                <Border Name="brdScore"
                        Grid.Column="1"
                        Width="200"
                       Style="{StaticResource HeaderBorderStyle}"
                >
                    <TextBlock x:Name="tbScore"
                               Text="Score: 0"
                               Width="100"
                               Style="{StaticResource HeaderTextBlockStyle}"
                    />
                </Border>
      
                <Border Name="brdMoveCount"
                        Grid.Column="2"
                        Width="200"
                        Style="{StaticResource HeaderBorderStyle}"
                >
                    <TextBlock x:Name="tbMoveCount"
                               Text=""
                               Width="190"
                               Style="{StaticResource HeaderTextBlockStyle}"
                    />
                </Border>
      
                <Border Name="brdGameTimer"
                        Grid.Column="4"
                        Width="200"
                        Style="{StaticResource HeaderBorderStyle}"
                >
                    <TextBlock x:Name="myTimerDisplay"
                               Width="190"
                               Style="{StaticResource HeaderTextBlockStyle}"
                    />
                </Border>
            </Grid>
        </Grid>

        <!--Game Tableu Playing Area -->
        <GridView x:Name="dataGridGameBoard"
                  Grid.Row="1"
                  ItemsSource="{x:Bind gameDeck.deckCards}"
                  Margin="2"
                  Height="595"
                  Width="1545"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="Blue"
                  BorderThickness="2"
                  IsItemClickEnabled="True"
                  SelectionMode="Single"
                  SelectionChanged="dataGridGameBoard_SelectionChanged"
        >

            <GridView.ItemTemplate>
                <DataTemplate x:Name="CardPosition"
                >
                    <StackPanel x:Name="PlayingCard"
                                Height="142"
                                Width="114"
                    >
                        <StackPanel.Resources>
                            <Storyboard x:Name="ZoomInMoveableKing">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1" To="1.5" Duration="0:0:0"
                                />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1" To="1.5" Duration="0:0:0"
                                />
                            </Storyboard>
                        </StackPanel.Resources>

                        <Border x:Name="CardBorder"
                                Height="138"
                                Width="110"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="White"
                                BorderThickness="1"
                                CornerRadius="10"
                                Background="DarkGray"
                        >
                            <Image x:Name="CardFace"
                                    Stretch="Uniform"
                                    Source="{Binding cardFace, Mode=TwoWay}"
                             />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="13"
                                   Orientation="Horizontal"
                    />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <!--Game Tableu Footer -->
        <Grid Name="grdActions"
              Grid.Row="2"
              Margin="2"
              Height="48"
              Width="1478"
              Background="Blue"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="46"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnNewGame"
                    Content="New Game"
                    Grid.Column="2"
                    Margin="2,2,2,2"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="btnNewGame_Click"
            />

            <Button x:Name="btnStats"
                    Content="Statistics"
                    Grid.Column="7"
                    Margin="2,2,2,2"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="btnStats_Click"
            />

            <Button x:Name="btnHelp"
                    Content="Help"
                    Grid.Column="8"
                    Margin="2,2,2,2"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="btnHelp_Click"
            />

            <Button x:Name="btnExit"
                    Content="Exit"
                    Grid.Column="9"
                    Margin="2,2,2,2"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="btnExit_Click"
            />
        </Grid>
    </Grid>
</Page>
