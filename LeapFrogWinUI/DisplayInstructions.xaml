<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="LeapFrogWinUI.DisplayInstructions"
               x:Name="MyPlayInstructions"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:LeapFrogWinUI"
               Background="Blue"
               BorderBrush="White"
               BorderThickness="2"
               CornerRadius="10"
               Height="600"
               Width="350"
               PrimaryButtonText="Ok"
>
    <Grid Name="grdDisplayInstructions"
          DataContext="myHelpText"
          Height="590"
          Width="340"
          VerticalAlignment="Top"
          HorizontalAlignment="Left"
    >
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="540"/>
        </Grid.RowDefinitions>
        
         <Grid x:Name="ttlSpInstructions"
               Grid.Row="0"
               Background="Blue"
               BorderBrush="White"
               BorderThickness="2"
               CornerRadius="10"
               VerticalAlignment="Top"
               HorizontalAlignment="Center"
               Height="36"
               Width="280"
         >
                <TextBlock Name="ttlPlayInstructions"
                           Text="How to Play LeapFrog"
                           TextAlignment="Center"
                           FontFamily="Helvetica"
                           FontSize="20"
                           FontWeight="Bold"
                           FontStyle="Italic"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Height="30"
                           Width="270"
                />
         </Grid>

         <ScrollViewer VerticalScrollBarVisibility="Visible"
                       Grid.Row="1"
                       BorderBrush="White"
                       BorderThickness="1"
         >
             <TextBlock x:Name="tbPlayInstructions"
                        Text="Default Text"
                        TextWrapping="Wrap"
                        FontSize="12"
                        FontWeight="Normal"
                        Foreground="White"
                        Width="320"
             />
         </ScrollViewer>
    </Grid>
</ContentDialog>
