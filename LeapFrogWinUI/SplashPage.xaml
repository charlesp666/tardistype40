<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LeapFrogWinUI.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LeapFrogWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Height="400"
    Width="800"
    >

    <!--Height="400"
          Width="810"-->

    <Grid HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Background="#FF0000C0"
          BorderBrush="White"
          BorderThickness="2"
          CornerRadius="10"
    >
         <!--<Grid.RowDefinitions>
             <RowDefinition Height="398"/>
         </Grid.RowDefinitions>-->
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="800"/>
         </Grid.ColumnDefinitions>

         <!--"Froggy" Game Image -->
         <Image x:Name="picGameImage"
                Source="/Assets/GameImages/Froggy.png"
                Height="398"
                Width="360"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="5,5,0,0"
                FocusVisualPrimaryBrush="#FF0000C0"
         />

         <!--Game Title -->
        <Grid Name="grdGameDetails"
              Grid.Column="1"
        >
            <TextBlock x:Name="lblGameTitle"
                       Text="lblGameTitle"
                       Height="auto"
                       Width="auto"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="5,5,0,0"
                       Foreground="White"
                       FontFamily="Arial Black"
                       FontWeight="ExtraBold"
                       FontSize="36"
            />
          
           <!--Game SubTitle -->
           <TextBlock x:Name="txtSubTitle"
                      Text="txtSubTitle"
                      Height="auto"
                      Width="auto"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="5,45,0,0"
                      FontFamily="Arial"
                      FontSize="24"
                      Foreground="White"
           />
          
           <!--Game Version -->
           <TextBlock x:Name="txtVersion"
                      Text="txtVersion"
                      Height="auto"
                      Width="auto"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="5,75,0,0"
                      FontFamily="Arial"
                      FontSize="18"
                      Foreground="White"
           />
          
           <!--Game Publisher -->
           <TextBlock x:Name="txtPublisher"
                      Text="txtPublisher"
                      Height="auto"
                      Width="auto"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="5,0,0,0"
                      FontFamily="Arial"
                      FontSize="18"
                      Foreground="White"
           />
          
           <!--Copyright Notice -->
           <TextBlock x:Name="lblCopyright"
                      Text="lblCopyright"
                      Height="auto"
                      Width="auto"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="5,45,0,0"
                      FontFamily="Arial"
                      FontSize="18"
                      Foreground="White"
           />
          
           <!--Rights Reserved -->
           <TextBlock x:Name="txtRights"
                      Text="txtRights"
                      Height="auto"
                      Width="auto"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="5,90,0,0"
                      FontFamily="Arial"
                      FontSize="16"
                      Foreground="White"
           />
          
           <!--Link to Game Tableau -->
           <!--<ProgressBar x:Name="linkToGameTableau"
                        Width="300"
                        Height="50"
                        Margin="5,320,0,0"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
           />-->
          
           <HyperlinkButton x:Name="LaunchGame"
                            Content="Launch Game"
                            Height="50"
                            Width="150"
                            Margin="5,320,0,0"
                            VerticalAlignment="Top"
                            FontFamily="Arial"
                            FontSize="16"
                            FontWeight="Bold"
                            FontStyle="Italic"
                            Foreground="White"
                            Background="Blue"
                            BorderBrush="White"
                            BorderThickness="2"
                            Click="btnLaunchGame_Click" Grid.RowSpan="2"
           />
        </Grid>
    </Grid>
</Page>
