<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LeapFrogWinUI.PlayerStatsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LeapFrogWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    Width="auto"
    Height="auto"
>
    <UserControl.Resources>
        <!--Style to Apply to the Display Player Statistics Dialog -->
        <Style x:Key="styleBorders"
               TargetType="Border"
        >
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
        </Style>

        <!--Style to Apply to the Display Player Statistics Dialog -->
        <Style x:Key="styleGrids"
               TargetType="Grid"
        >
            <Setter Property="Background" Value="Blue"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
        </Style>

        <!--Style to Apply to the Display Player Statistics Dialog -->
        <Style x:Key="styleHdrSections"
               TargetType="TextBlock"
        >
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontFamily" Value="Helvetica"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--Style to Apply to the Display Player Statistics Dialog -->
        <Style x:Key="styleHdrTextBlocks"
               TargetType="TextBlock"
        >
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--Style to Apply to the Display Player Statistics Dialog -->
        <Style x:Key="styleTextBlocks"
               TargetType="TextBlock"
        >
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontFamily" Value="Helvetica"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Name="playerStats"
          Background="Blue"
          Margin="2,2,0,0"
          Width="auto"
          Height="auto"
    >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Display the Header for the Dialog-->
        <Grid Name="iconFroggyStats"
              Grid.Row="0"
        >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!--Display the "Froggy Stats" icon/image-->
            <Border Name="bdrStatsImage"
                    Grid.Column="0"
                    Style="{StaticResource styleBorders}"
            >
                <Image x:Name="picStatsImage"
                       Source="/Assets/GameImages/FroggyStats.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Height="80"
                       Width="90"
                       FocusVisualPrimaryBrush="#FF0000C0"
                />
            </Border>

            <!--Display Dialog Header icon/image-->
            <Border Name="bdrHdrPlayerStats"
                    Grid.Column="1"
                    Style="{StaticResource styleBorders}"
            >
                <TextBlock Name="hdrPlayerStats"
                           Text="Player Statistics"
                           Style="{StaticResource styleHdrTextBlocks}"
                />
            </Border>
        </Grid>

        <!-- Display the Accumulated Statistics, e.g.: Total Moves; total time; etc.-->
        <Grid Name="dispPlayerGameDates"
              Grid.Row="1"
              Height="70"
              Width="490"
              Style="{StaticResource styleGrids}"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Display the First Date Played-->
            <TextBlock Name="lblGameFirstPlayed"
                       Grid.Row="0"
                       Grid.Column="0"
                       Text="Game First Played: "
                       Style="{StaticResource styleTextBlocks}"
            />
            <TextBlock Name="txtGameFirstPlayed"
                      Grid.Row="0"
                      Grid.Column="1"
                      Text=""
                      Style="{StaticResource styleTextBlocks}"
            />

            <!-- Display the Most Recent Date Played-->
            <TextBlock Name="lblGameMostRecentlyPlayed"
                       Grid.Row="1"
                       Grid.Column="0"
                       Text="Game Most Recently Played: "
                       Style="{StaticResource styleTextBlocks}"
            />
            <TextBlock Name="txtGameMostRecentlyPlayed"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text=""
                       Style="{StaticResource styleTextBlocks}"
            />
        </Grid>

        <!-- Display the Accumulated Statistics, e.g.: Total Moves; total time; etc.-->
        <Grid Name="dispPlayerStats"
              Grid.Row="2"
              Height="130"
              Width="490"
              Style="{StaticResource styleGrids}"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Display Section Header-->
            <TextBlock Name="lblDataSectionHeader"
                       Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Text="Accumulated Statistics"
                       Style="{StaticResource styleHdrSections}"
            />

            <!-- Display the Total Time Played-->
            <TextBlock Name="lblTimePlayed"
                       Grid.Row="1"
                       Grid.Column="0"
                       Text="Total Time of Games Played: "
                       Style="{StaticResource styleTextBlocks}"
            />
            <TextBlock Name="txtTimePlayed"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text=""
                       Style="{StaticResource styleTextBlocks}"
            />

            <!-- Display the Count of Games Played-->
            <TextBlock Name="lblGameCount"
                       Grid.Row="2"
                       Grid.Column="0"
                       Text="Number of Games Played: "
                       Style="{StaticResource styleTextBlocks}"
            />
            <TextBlock Name="txtGameCount"
                       Grid.Row="2"
                       Grid.Column="1"
                       Text=""
                       Style="{StaticResource styleTextBlocks}"
            />

            <!-- Display the Players Total Score-->
            <TextBlock Name="lblTotalScore"
                       Grid.Row="3"
                       Grid.Column="0"
                       Text="Total Score For All Games: "
                       Style="{StaticResource styleTextBlocks}"
            />
            <TextBlock Name="txtTotalScore"
                       Grid.Row="3"
                       Grid.Column="1"
                       Text=""
                       Style="{StaticResource styleTextBlocks}"
            />
        </Grid>

        <!-- Display Computed Statistics, e.g.: Mean Moves per game; mean time dper game; etc.-->
        <Grid Name="dispPlayerComputedStats"
              Grid.Row="3"
              Height="100"
              Width="490"
              Style="{StaticResource styleGrids}"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Display Section Header-->
            <TextBlock Name="lblComputedSectionHeader"
                       Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Text="Computed Statistics"
                       Style="{StaticResource styleHdrSections}"
            />

            <!-- Display the Mean Time per Game-->
            <TextBlock Name="lblMeanTimePerGame"
                           Grid.Row="1"
                           Grid.Column="0"
                           Text="Mean Time per Game: "
                           Style="{StaticResource styleTextBlocks}"
            />
            <TextBlock Name="txtMeanTimePerGame"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text=""
                           Style="{StaticResource styleTextBlocks}"
            />

            <!-- Display the Mean Score per Game-->
            <TextBlock Name="lblMeanScorePerGame"
                           Grid.Row="2"
                           Grid.Column="0"
                           Text="Mean Score per Game: "
                           Style="{StaticResource styleTextBlocks}"
            />
            <TextBlock Name="txtMeanScorePerGame"
                           Grid.Row="2"
                           Grid.Column="1"
                           Text=""
                           Style="{StaticResource styleTextBlocks}"
            />
        </Grid>

        <!-- Display the Current Game Statistics-->
        <Grid Name="dispCurrentGame"
              Grid.Row="4"
              Height="100"
              Width="490"
              Style="{StaticResource styleGrids}"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Display Section Header-->
            <TextBlock Name="lblCurrentSectionHeader"
                       Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Text="Current Game Statistics"
                       Style="{StaticResource styleHdrSections}"
            />

            <!-- Display the Total Time Played-->
            <TextBlock Name="lblCurrentTimePlayed"
                       Grid.Row="1"
                       Grid.Column="0"
                       Text="Total Time: "
                       Style="{StaticResource styleTextBlocks}"
            />
            <TextBlock Name="txtCurrentTimePlayed"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text=""
                       Style="{StaticResource styleTextBlocks}"
            />

            <!-- Display the Players Total Score-->
            <TextBlock Name="lblCurrentScore"
                       Grid.Row="2"
                       Grid.Column="0"
                       Text="Total Score For All Games: "
                       Style="{StaticResource styleTextBlocks}"
            />
            <TextBlock Name="txtCurrentScore"
                       Grid.Row="2"
                       Grid.Column="1"
                       Text=""
                       Style="{StaticResource styleTextBlocks}"
            />
        </Grid>
    </Grid>
</UserControl>
