<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="WinUiPlayApp.DisplayInstructions"
               x:Name="MyPlayInstructions"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:WinUiPlayApp"
               Background="Blue"
               BorderBrush="White"
               BorderThickness="2"
               CornerRadius="10"
               Height="500"
               Width="240"
               PrimaryButtonText="Ok"
>
    <Grid Name="grdDisplayInstructions"
          DataContext="myHelpText"
          Height="290"
          Width="230"
          VerticalAlignment="Top"
          HorizontalAlignment="Left"
    >
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="450"/>
        </Grid.RowDefinitions>
        
         <Grid x:Name="ttlSpInstructions"
               Grid.Row="0"
               Background="Blue"
               BorderBrush="White"
               BorderThickness="2"
               CornerRadius="10"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Height="36"
               Width="220"
         >
                <TextBlock Name="ttlPlayInstructions"
                        Text="How to Play LeapFrog"
                        TextAlignment="Center"
                        FontFamily="Helvetica"
                        FontSize="20"
                        FontWeight="Bold"
                        FontStyle="Italic"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Height="30"
                        Width="210"
                />
         </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      Grid.Row="1"
                      Height="430"
                      Width="230"
                      Background="Blue"
                      BorderBrush="Black"
                      BorderThickness="2"
        >
            <TextBlock x:Name="tbPlayInstructions"
                    Text="Default Text."
                    TextWrapping="WrapWholeWords"
                    FontSize="12"
                    FontWeight="Normal"
                    Foreground="White"
         />
        </ScrollViewer>
    </Grid>
</ContentDialog>
