<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUiPlayApp.Page2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUiPlayApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
>

    <Page.Resources>
        <!--Style to Apply to the Dislay Player Statistics Dialog -->
        <Style x:Key="DialogButtonStyle"
               TargetType="Button"
        >
            <Setter Property="Background" Value="Blue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid Name="gameTableau"
          Background="Blue"
          BorderThickness="2"
          BorderBrush="White"
          CornerRadius="10"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <Grid Name="bdrHeader"
                  Grid.Row="0"
                  Margin="2,2"
                  Background="Blue"
                  BorderThickness="1"
                  BorderBrush="Black"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
            >
                <TextBlock x:Name="pageTitle"
                           Text="Page 2"
                           Margin="16"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Foreground="White"
                />
            </Grid>

            <Grid Name="bdrSecondGrid"
                  Grid.Row="1"
                  Margin="2,2"
                  Background="Blue"
                  BorderThickness="1"
                  BorderBrush="Black"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
            >
                <HyperlinkButton Content="Click to go to main page"
                                 Click="HyperlinkButton_Click"
                                 HorizontalAlignment="Center"
                                 Foreground="White"
                />

                <StackPanel Name="pnlTextRefresh"
                            Margin="100"
                >
                    <TextBox Name="UpdatedText"
                             Text="Unchanged"
                             Foreground="White"
                    />
                    <TextBlock Text="{Binding CurrentActivityText}"
                               FontSize="20"
                               Foreground="White"
                    />
                    <Button Content="Update Text"
                            Click="UpdateTextButton_Click"
                            Foreground="White"
                     />
                </StackPanel>
            </Grid>

            <Grid Name="bdrThirdGrid"
                  Grid.Row="2"
                  Margin="2,2"
                  Background="Blue"
                  BorderThickness="1"
                  BorderBrush="Black"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  CornerRadius="10"
            >
                <Button x:Name="btnHelp"
                    Content="Help"
                    Grid.Column="8"
                    Margin="2,2,2,2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    FontSize="24pi"
                    Foreground="White"
                    Click="btnHelp_Click"
                />
            </Grid>

            <Grid Name="bdrFourthGrid"
                  Grid.Row="3"
                  Margin="2,2"
                  Background="Blue"
                  BorderThickness="1"
                  BorderBrush="Black"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  CornerRadius="10"
            >
                <Button x:Name="btnPlayerStats"
                        Content="Stats"
                        Grid.Column="8"
                        Margin="2,2,2,2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="24pi"
                        Foreground="White"
                        Click="btnPlayerStats_Click"
                />
            </Grid>
            
            <Grid Name="bdrGameTimer"
                  Grid.Row="4"
                  Grid.Column="6"
                  Margin="2,2"
                  Background="Blue"
                  BorderThickness="1"
                  BorderBrush="Black"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  CornerRadius="10"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="myTimerDisplay"
                         Grid.Column="0"
                         HorizontalAlignment="Center"
                         HorizontalTextAlignment="Center"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Height="auto"
                         Width="auto"
                         FontFamily="Helvetica"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="White"
                />
                
                <Button x:Name="btnStartTimer"
                        Content="Start Timer"
                        Grid.Column="1"
                        Margin="2,2,2,2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="24pi"
                        Foreground="White"
                        Click="btnStartTimer_Click"
                />

                <Button x:Name="btnStopTimer"
                        Content="Stop Timer"
                        Grid.Column="2"
                        Margin="2,2,2,2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="24pi"
                        Foreground="White"
                        Click="btnStopTimer_Click"
                />
            </Grid>
        </Grid>
    </Grid>
</Page>
